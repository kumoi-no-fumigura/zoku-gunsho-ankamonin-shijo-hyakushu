   "speaker": "",
   "page": 3,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路早春",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "けさはみな露にけりなさゝ浪やあふみの海はそらもひとつに",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "御上朝霞",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "木すゑこそそれともみへねはゝそ原いはたの小野はすみこめつゝ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞隔遠樹",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "きゝなさしさ名は扨のうらひすを旅のそらまてたれをくりれん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞隔遠樹",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "ちかけれと人のまかきの竹なれはへたてゝつらし蛍のこゑ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薩我性鶯",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "とちこむか氷の下の登田にいかて若菜の春をしるらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田辺若菜",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "〽おかめやかすゑ野ゝ原の春草につもかとこれはきゆるあと雪",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野外残雪",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "梅かゝをみねのあらしやさそふらんさなからかほる春の山ちを",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山路梅花",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "春かせの吹かとろかす梅かゝにねなましとこは夢にむすはす",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅薫夜風",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "河岸のあやうなからもわか身世に久しく一ぬる青柳のいと",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水造古柳",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "咲むへき口数はふれと山さくらもよほすまに猶そつれなき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雨中待花",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "尋ぬへきみ山桜をゝきなからすそのゝ花に今かやくらさん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野花留人",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "山桜色たちまかふくもとなを宴に消てえやはこえける",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠望山花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "一しつめのすれを去はしとめかほに花ありかくす庭のかよひちて",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁庭落花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "ゆふれの妻れすか故郷に人えぬ花の何匂ふら雫",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一枚郷弐袋宛",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "影やとす月をそれとも分かぬつふかき霞のなか川の水",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河上春月",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "春のよの丸明の月もいてぬまにかへかこしちをいそくかりかね",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深夜飯雁",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "むらさきの雲のゆきゝをさためぬや藤さく比のみねの松かせ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一藤花随風",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "玉ふきの花色ころもかけてけりさほの川原の瀬々の岩はし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋進疑冬",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "〽こくにくれ行春ももろともにさも跡もなき浪のうへかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "舟中善春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "わかためはあな卯念のさかりとていとふ山路も諸たへぬへし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花隠路",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "ことし又はつ音はきゝつほとゝきすはたかはれつかいのちまつなり",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初聞郭公",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "まちわたる此山本もほときすなかなくさとの数にもらすな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家時鳥",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "五月とて遣さ哥あやめなかきねに池の心もそこしられつゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "記朝菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "かやり火の煙のすゑもやとからはおもひなしにやさひしかるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "│閑居坂火",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "にほえなゝ梅にかはせるそてのかつなこりもしるき軒のたちはな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "慮橋驚夢",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "さしてそのみかさの杜をたのめとも猶袖ほさぬさえたれのうろ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "廿五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "おもふ事あまりにゑけき夏草の下にみたるゝをのゝゆふ露",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野夕夏草",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "たれかしる忍ふの山の谷ふかみもゆる蛍のおもひありとも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "洞底蛍火",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "ゆくさきも家路も遠き半てにやとかかかけなきいふたちのあめ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行路夕立",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "遣さかはか風につけてや夜の葉も露をきめへぬあきをしるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初妹朝風",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "〽おろしくはのちのふ月のかぬかにも又星あひのある夜なりせは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "四月七夕",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "〽花にさり秋の宮枝のゆふくれをかけてむすへる野へのかりいほ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野亭夕萩",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "あかすゝる入江の月をおしむ間によも明にたる荻のうはかせ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "所辺曙夜",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "山みゆるわつかりかねのをとつれも軒はにちかき雲のかよひち",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家初雁",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "興津舟ゆたのたゆたにこきたれはよるへなみちは月そまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海上侍同",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "たかさこの松に木のはのなかりせはいさよふ月を猶やまたまし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松間夜月",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "あきの夜の夜の哀は月に去られけり鳥の音きかぬ太山なれとも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "深山九月",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "こきませて草の花さし秋のゝに露に立たかふ月のいろ〳〵",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草露映月",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "かくはかり出しむこゝろをとはかりの関ともいはす月そ明ゆく",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "闇路惜月",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "うとかりしみ山の鹿も夜もすからなくを反とてたつね床にけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿麦夜友",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "夜さむなる山田のをしねかりそめのいほもかしつもころもうつなり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家抜衣",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "たとらもなわたしおれたる浪路とて霧の下こくよとの川に",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古渡飛露",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "あたし野は露のかくれもなかり参り秋風たちて色かはるころ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一統風満の",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "くすかつら上る人たゆるまかきにも心なからやむつむしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬下聞虫",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "一谷川のろもしくれや染つらん峯のもみちの千しほうつして",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉写水",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "ありとたに人にしられぬ紅葉哉木すえは四方の山をへたてゝ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "口影まつ露のしけさをゝもしとやかつしほるらんあさかほの花",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "露庭権花",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "むすふてに香こそくるけれ白栄の岡の云ひたす山川の水",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河野南図",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "をく霜もたれと共にかはらましふるき枕にあきのくれなは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "物惜暮秋",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "ことさらにうちしくれてそしらせける空さためなき水のはしめを",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬十首初冬時雨",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "ちかつもる谷の木のこのくれな井に色ことになす老のあさゑも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜埋落葉",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "しくれにも木のみにもにぬ音たてゝあられはしるき板ひさし哉",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "屋上関霰",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "霞よりもさへまさからし初雪のふりそふ山のかねのひゝきも",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古寺初雪",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "一しら雪の庭をさかりに消ぬ間にとへとおもひし人もまたれす",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭雪獣人",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "興津かせ雪吹かけて白たへになるをの松は葉かへして遣り",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺松雪",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "難波江やありしにもあらぬ水枯にあとまなはるた霞のあし原",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水郷寒蓋",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "とをさかるかた日の沖のさよちとり跡やはとめぬ浪のうへには",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖上千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "かつこほる涙のとこにならはすいをしつらきねもよそにきかまし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒夜水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "谷水のうへはつれおくこほふるともあすを春とや下にとくらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮開水",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "〽ことはんおもふそかたのうき雲にかゝる心のしるへありやと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初耳縁恋",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "音はかりそれと鳴こす松かせを身にしむとたに人にしらせし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関勢恩恋",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "〽いつまてそ年月とをくなからへてちきりしすゑを左のむ命も",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一安経年恋",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "まことゝは思ひまためぬことのこもよし多くしはし雨のこそせめ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "疑真偽恋",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "よそへても猶ことまれぬなてしこに露をきそふる水くきのあと",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返事増慈",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "ことはりやさしもせはしきむくらふの宿からつゝき人の夜かれは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "被助賤慈",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "なをきりの道行ふりもわするなよちきりしまゝのこゝろかはらて",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "途中賢右衛門",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "尋ねつる人はつれなき真木の戸をあせぬ夜なからさてやかへらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一従門帰応",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "せめておもふ心まよひといひなからをしへし宿をさやはわすれん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一同御慈悲",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "〽なからへてあふをかきりとたのますはおしからぬ身をいのりやはせん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "依恋祈身",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "野も山もこへていくかをへたつらんさかいわるかにまかふこひちは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一隔遠路立",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "かよふとはよひ〳〵ことにしかくともあらぬ人をやそれといとまし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "借人名立",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "おほつかな嵐にまかふさゝかにのいかなるかたとなれにとはまし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "跡不知恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "はては又つらさくらへもことのはもをのかさま〳〵色かはりけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立恨絶恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "香の音にわか涙そふあかつきをいつよりなれしね覚出るしん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁更寝覚",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "いとせめて夕くれもにかなしきはきく我からに底の松かせ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "薄暮松風",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "なに竹の心にはさはよのほとの雨にもたへすなれふしにけり",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "両中縁竹",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "苔よりもわかおきぬらすたくひとや岩こす波のまおくかへらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浪焼石苔",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "よのつねの山にはまさる峯ならはまつよふくるも月のとかゝは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "高山侍同",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "遠近のいも世の山のへたてつすはよしのゝ瀧やあらハならまし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山中渡水",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "あさしとはおもひなはてそ山川の庭身てきまたこゝろみへしねは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河水流清",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "すみれつむ春のからひに藤さく野をなつかし候やとやからまし",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春秋野遊",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "東路の間のゆきゝはされとしも去らぬになるゝちきり有けり",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関路行香",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "あらし吹山の柴屋のすことさよなれて年ふるゆふへなれとも",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家夕嵐",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "すこあらすいほりあまたになかにけり猶うき時をわかしのふまに",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家人稀",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "山もなく雲もかはらてうなはしやゆくゑも去らぬなみのはてかな",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海路眺望",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "をくりくる月をよな〳〵たのむかな旅のそらゆく友なしにして",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月羇中友",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "一夜もすから雨に涙を手もたゆくしほりそへたる旅ころもかな",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿夜雨",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "いもか島かたみの月のあり明に浪うそかけね雪なへたてそ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺暁雲",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "有物とたのむこの世のはかなさは夢をみてこそおもひあはすな",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄夢無常",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "ねわたへてみなはにましる萍のうきなから又ゆくかたもなし",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草述懐",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "一枝かはすむかしのちきり朽はてゝひとりふる木のなにのこるらん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木述懐",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "年月も遠さかり行むかしそとおもふにつけてこひぬ日はなし",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "通日懐旧",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "よろつよをさそなひさしくてらすらん雨のむ日よしの神のちかひは",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733159",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社頼祝言",
   "kotobagaki": ""
  }
 ],
